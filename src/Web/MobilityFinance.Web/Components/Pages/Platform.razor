@page "/platform"
@attribute [Authorize(Policy = AuthorizationPolicies.PlatformAdministration)]

<PageTitle>Platform operations | Mobility Finance</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Platform administration</p>
        <h1>Delivery and service operations</h1>
        <p>Inspect service health, dead letters, replay controls, SLOs, dashboards, and traces.</p>
    </div>
</section>

<section class="content-grid">
    <article class="panel">
        <p class="eyebrow">Messaging</p>
        <h2>Recovery controls</h2>
        <p class="muted">Broker outage recovery is executable and replay remains explicit, authorized, and audited.</p>
    </article>
    <article class="panel">
        <p class="eyebrow">Observability</p>
        <h2>Cross-service traces</h2>
        <p class="muted">OpenTelemetry exports HTTP and runtime signals to the local Prometheus, Tempo, and Grafana stack.</p>
        <div class="panel-actions">
            <a class="button button-secondary" href="http://localhost:3000" target="_blank" rel="noopener noreferrer">Open Grafana</a>
            <a class="button button-secondary" href="http://localhost:9090" target="_blank" rel="noopener noreferrer">Open Prometheus</a>
        </div>
    </article>
</section>
